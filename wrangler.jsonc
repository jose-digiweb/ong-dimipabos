{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ong-dimipabos",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-26",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dimipabos",
			"database_id": "a4e51623-0de3-4c5d-9cc5-d0b5ee4278d5",
		},
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "dimipabos",
		},
	],
	"vars": {
		"R2_PUBLIC_URL": "https://storage.ongdimipabos.org",
	},
	"observability": {
		"enabled": true,
	},
}
