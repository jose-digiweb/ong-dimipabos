{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ong-dimipabos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dimipabos",
      "database_id": "a4e51623-0de3-4c5d-9cc5-d0b5ee4278d5",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "dimipabos",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["contact@ongdimipabos.org"],
    },
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://storage.ongdimipabos.org",
    "CONTACT_FROM_ADDRESS": "noreply@ongdimipabos.org",
    "CONTACT_FROM_NAME": "DI MI PA BÔS",
    "CONTACT_TO_ADDRESS": "contact@ongdimipabos.org",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADX_maCjLdoRjeSa",
  },
  "observability": {
    "enabled": true,
  },
}
