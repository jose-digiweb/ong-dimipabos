{
  "name": "ong-dimipabos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "wlogin": "wrangler login",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute dimipabos --local --file",
    "db:migrate:remote": "wrangler d1 execute dimipabos --remote --file",
    "db:studio": "drizzle-kit studio",
    "bake:og": "bun run scripts/bake-og-image.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "^5.74.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "posthog-js": "^1.376.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wrangler": "^4.95.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^20.17.16",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript/native-preview": "^7.0.0-dev.20260525.1",
    "drizzle-kit": "^0.31.4",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "react-email": "^6.5.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2"
  }
}
