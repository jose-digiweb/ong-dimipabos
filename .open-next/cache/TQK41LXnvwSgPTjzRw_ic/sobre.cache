ildren\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-handshake size-6 text-secondary\",\"children\":[[\"$\",\"path\",\"efffak\",{\"d\":\"m11 17 2 2a1 1 0 1 0 3-3\"}],[\"$\",\"path\",\"9pr0kb\",{\"d\":\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"}],[\"$\",\"path\",\"1tisrp\",{\"d\":\"m21 3 1 11h-2\"}],[\"$\",\"path\",\"1uvwmv\",{\"d\":\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"}],[\"$\",\"path\",\"1ep09j\",{\"d\":\"M3 4h8\"}],\"$undefined\"]}]}],[\"$\",\"div\",null,{\"className\":\"flex size-12 items-center justify-center rounded-full bg-accent/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-eye size-6 text-accent-foreground\",\"children\":[[\"$\",\"path\",\"1nclc0\",{\"d\":\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"}],[\"$\",\"circle\",\"1v7zrd\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"3\"}],\"$undefined\"]}]}]]}],false,false]}]]}]]}]\n13:[\"$\",\"section\",null,{\"id\":\"historia\",\"className\":\"bg-slate-50 py-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-12 md:grid-cols-[1fr_35%] lg:gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-pretty font-bold text-3xl text-foreground tracking-tight sm:text-4xl\",\"children\":\"Nossa História\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-6 text-lg text-muted-foreground\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-pretty\",\"children\":\"A ONG DI MI PA BÔS nasceu em 2021 com um propósito simples, mas essencial: levar ajuda a quem mais precisa. Inicialmente, nosso foco estava em doações, fornecendo apoio básico para pessoas em situação de vulnerabilidade na Guiné-Bissau. No entanto, ao longo do nosso trabalho, percebemos uma necessidade ainda maior — um espaço seguro e estruturado para acolher e tratar pessoas que lutam contra a dependência química.\"}],[\"$\",\"p\",null,{\"className\":\"text-pretty\",\"children\":\"Dessa constatação, surgiu o nosso grande projeto: a construção de um centro de acolhimento e tratamento para pessoas que enfrentam desafios com o uso de substâncias. Esse centro será um lugar onde elas poderão se recuperar com dignidade, recebendo tratamento adequado e um acompanhamento contínuo para garantir sua reabilitação e reintegração à sociedade.\"}],[\"$\",\"p\",null,{\"className\":\"text-pretty\",\"children\":\"Ainda estamos em fase de construção, mas cada passo que damos é movido pelo compromisso de transformar vidas. Com o apoio da comunidade, parceiros e doadores, estamos construindo um futuro onde mais pessoas tenham a chance de recomeçar.\"}],[\"$\",\"p\",null,{\"className\":\"text-pretty\",\"children\":\"Junte-se a nós nessa missão e ajude a tornar esse sonho realidade! 💙✨\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"relative mx-auto w-96 md:mx-0 md:my-auto md:w-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"aspect-square overflow-hidden rounded-full drop-shadow-md\",\"children\":[\"$\",\"$L1f\",null,{\"fill\":true,\"src\":\"$12:props:children:1:props:children:0:props:children:props:src\",\"alt\":\"Fundação da ONG\",\"className\":\"h-full w-full rounded-full object-contain drop-shadow-xs\"}]}]}]]}]}]}]\n14:[\"$\",\"section\",null,{\"className\":\"py-16\",\"children\":[\"$\",\"div\",nul